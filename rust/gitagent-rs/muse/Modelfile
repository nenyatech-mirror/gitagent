# Muse Glimmer 30B (2-bit) — chat template fix.
# The unsloth GGUF ships a Jinja template Ollama can't render (Ollama uses Go
# templates), so chat requests produced empty output. This Modelfile implements
# Muse's native format (<|start|>role<|message|>…<|eot|>) as a Go template.
# Tool calls are requested as fenced JSON, which Ira recovers natively.
#   ollama create muse-glimmer:q2 -f muse/Modelfile
FROM hf.co/unsloth/Muse-Glimmer-30B-GGUF:UD-IQ2_XXS

TEMPLATE """{{- range .Messages }}
{{- if eq .Role "system" }}<|start|>system<|message|>{{ .Content }}
{{- if $.Tools }}

You can call functions. To call one, reply with ONLY a fenced json code block exactly like:
```json
{"name": "<function>", "arguments": {<args>}}
```
Available functions:
{{- range $.Tools }}
- "{{ .Function.Name }}" — {{ .Function.Description }}
{{- end }}
{{- end }}<|eot|>
{{- else if eq .Role "user" }}<|start|>user<|message|>{{ .Content }}<|eot|>
{{- else if eq .Role "assistant" }}<|start|>assistant<|message|>{{ .Content }}{{ range .ToolCalls }}```json
{"name": "{{ .Function.Name }}", "arguments": {{ .Function.Arguments }}}
```{{ end }}<|eot|>
{{- else if eq .Role "tool" }}<|start|>tool<|message|><tool_output>
{{ .Content }}
</tool_output><|eot|>
{{- end }}
{{- end }}<|start|>assistant"""

# <|eot|> ends the turn. (<|eom|> is NOT a stop: it separates the model's
# to=self reasoning channel from the to=user answer channel mid-turn.)
PARAMETER stop <|eot|>
PARAMETER num_ctx 8192
