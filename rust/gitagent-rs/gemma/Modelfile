# Adds a tool-calling template on top of Gemma 3 (which ships completion-only).
# Build the tools-capable model with:
#   ollama create gemma3-tools -f gemma/Modelfile
# Then `ira -d gemma` uses it (agent.yaml points at ollama:gemma3-tools).
#
# Referencing .Tools makes Ollama accept the tools param + inject the tool defs;
# Ira recovers the tool call from the model's text output. Use gemma3:4b (or a
# larger tool-tuned model) — gemma3:1b is too small to call tools reliably.
FROM gemma3:4b

TEMPLATE """{{- if .Tools }}<start_of_turn>user
You have access to these tools. To use one, output ONLY a fenced json code block and NOTHING else:
{{ range .Tools }}
• "{{ .Function.Name }}" — {{ .Function.Description }}{{ end }}

Rules:
- The "name" value MUST be copied EXACTLY from the list above (for example "cli", "read", or "write").
- NEVER invent a name and NEVER use the assistant's own name.
Example — to run a shell command with the cli tool:
```json
{"name": "cli", "arguments": {"command": "ls -la"}}
```
<end_of_turn>
{{ end }}
{{- range $i, $_ := .Messages }}
{{- $last := eq (len (slice $.Messages $i)) 1 }}
{{- if or (eq .Role "user") (eq .Role "system") }}<start_of_turn>user
{{ .Content }}<end_of_turn>
{{ if $last }}<start_of_turn>model
{{ end }}
{{- else if eq .Role "assistant" }}<start_of_turn>model
{{ .Content }}{{ range .ToolCalls }}```json
{"name": "{{ .Function.Name }}", "arguments": {{ .Function.Arguments }}}
```{{ end }}{{ if not $last }}<end_of_turn>
{{ end }}
{{- else if eq .Role "tool" }}<start_of_turn>user
Tool result: {{ .Content }}<end_of_turn>
{{ if $last }}<start_of_turn>model
{{ end }}
{{- end }}
{{- end }}"""
